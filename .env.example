# URL pública da aplicação (produção).
NEXT_PUBLIC_APP_URL="https://capsulatecnologia.com.br"

# Copie este arquivo para .env (Prisma) e .env.local (Next.js).
# Preferir a connection string Direct / unpooled do Neon para prisma db push.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Segredo para o cookie de sessão.
AUTH_SECRET="troque-por-um-segredo-longo"
