generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  planejamento
  em_andamento
  concluido
  cancelado
}

enum Area {
  automacao
  mecanica
  hardware
  software
  gestao
  compras
  financeiro
  pcp
}

enum TaskPhase {
  planejamento
  desenvolvimento
  testes
  entrega
  finalizado
}

enum UserStatus {
  pending
  active
  rejected
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(active)
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model Collaborator {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String
  area      Area
  phone     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  ledProjects   Project[]     @relation("ProjectLeader")
  assignedTasks Task[]
  teams         ProjectTeam[]
}

model Client {
  id        String    @id @default(cuid())
  name      String
  contact   String    @default("")
  email     String    @default("")
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String        @default("")
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leaderId        String?
  leader          Collaborator? @relation("ProjectLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  durationDays    Int
  status          ProjectStatus @default(planejamento)
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  budget          Float         @default(0)
  budgetAutomacao Float         @default(0)
  budgetMecanica  Float         @default(0)
  budgetHardware  Float         @default(0)
  budgetSoftware  Float         @default(0)
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  tasks           Task[]
  team            ProjectTeam[]
  shares          ProjectShare[]
}

model ProjectShare {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token        String    @unique
  login        String
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([projectId])
}

model ProjectTeam {
  projectId      String
  collaboratorId String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@id([projectId, collaboratorId])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String?
  actorName   String
  actorEmail  String
  field       String
  action      String   @default("update")
  entityType  String
  entityId    String
  entityLabel String
  summary     String
  oldValue    String   @default("")
  newValue    String   @default("")

  @@index([entityType, entityId, createdAt])
  @@index([field, createdAt])
  @@index([createdAt])
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  children     Task[]    @relation("Subtasks")
  phase        TaskPhase
  seq          Int
  name         String
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  durationDays Int       @default(1)
  assigneeId   String?
  assignee     Collaborator? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  completed    Boolean   @default(false)
  completedAt  DateTime? @db.Date
  progress     Int       @default(0)
  dependencies String[]  @default([])
  order        Int       @default(0)
  collapsed    Boolean   @default(false)
}
